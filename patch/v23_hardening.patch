+    private void verifyDisplayRotation(int target, int attempt) {
+        new Handler(Looper.getMainLooper()).postDelayed(() -> {
+            boolean verified = false;
+            int actual = Surface.ROTATION_0;
+            try {
+                WindowManager wm = (WindowManager) getSystemService(WINDOW_SERVICE);
+                if (wm != null) {
+                    actual = wm.getDefaultDisplay().getRotation();
+                    verified = actual == target;
+                }
+            } catch (Exception ignored) {
+            }
+
+            getSharedPreferences("state", MODE_PRIVATE).edit()
+                    .putInt("rotation_actual", actual)
+                    .putBoolean("rotation_verified", verified)
+                    .apply();
+
+            if (!verified && attempt < 10
+                    && getSharedPreferences("state", MODE_PRIVATE).getBoolean("enabled", false)) {
+                verifyDisplayRotation(target, attempt + 1);
+            }
+        }, attempt == 0 ? 120 : 180);
+    }
